{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "evidence_id", "evidence_hash", "hypothesis_ids", "status", "decision_id", "question_version", "mandatory", "coverage", "provenance", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_id": {"type": "string"},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hypothesis_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["generic_evidence_preserved", "applied", "pending_review"]},
    "decision_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "question_version": {"type": "string"},
    "mandatory": {"type": "boolean"},
    "coverage": {"type": "object"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "created_at": {"type": "string"},
    "relation_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  },
  "additionalProperties": false
}
