{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "exam_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "exam_locator": {
            "type": "string",
            "minLength": 1
          },
          "question_number": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "exam_locator",
          "question_number",
          "source",
          "locator",
          "quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "exam_id",
    "entries"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit exam question to answer-key source-span mapping"
}
