{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "architecture_version": {
      "const": "teacher-intelligence-0.1"
    },
    "implementation_milestone": {
      "const": "0.3"
    },
    "engine_version": {
      "const": "exact-question-local-1"
    },
    "scope": {
      "type": "object",
      "properties": {
        "teacher_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "teacher_identity_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "teacher_id",
        "subject",
        "label",
        "teacher_identity_verified"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "properties": {
        "min_support": {
          "type": "integer",
          "minimum": 1
        },
        "max_path_edges": {
          "enum": [
            2,
            3
          ]
        },
        "min_path_edges": {
          "const": 2
        },
        "max_motif_nodes": {
          "enum": [
            3,
            4
          ]
        },
        "min_motif_nodes": {
          "const": 3
        },
        "max_candidates_per_question_mode": {
          "type": "integer",
          "minimum": 1
        },
        "subgraph_mode": {
          "const": "connected_induced"
        },
        "support_unit": {
          "const": "distinct_question"
        },
        "modes": {
          "const": [
            "reasoning_structure",
            "concept_reasoning"
          ]
        }
      },
      "required": [
        "min_support",
        "max_path_edges",
        "min_path_edges",
        "max_motif_nodes",
        "min_motif_nodes",
        "max_candidates_per_question_mode",
        "subgraph_mode",
        "support_unit",
        "modes"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "selected_questions": {
          "type": "integer",
          "minimum": 0
        },
        "included_questions": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "exam_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "const": "legacy_needs_reanalysis"
              }
            },
            "required": [
              "question_id",
              "exam_id",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "denominator_unit": {
          "const": "included_distinct_question"
        },
        "exam_filter": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "active_index_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "selected_questions",
        "included_questions",
        "excluded_questions",
        "denominator_unit",
        "exam_filter",
        "active_index_hash"
      ],
      "additionalProperties": false
    },
    "exam_denominators": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "input_graphs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "exam_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "question_id",
          "exam_id",
          "revision",
          "content_hash"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "integer",
          "minimum": 0
        },
        "patterns": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            },
            "paths": {
              "type": "integer",
              "minimum": 0
            },
            "subgraphs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "nodes",
            "edges",
            "paths",
            "subgraphs"
          ],
          "additionalProperties": false
        },
        "repeated_patterns": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            },
            "paths": {
              "type": "integer",
              "minimum": 0
            },
            "subgraphs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "nodes",
            "edges",
            "paths",
            "subgraphs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "questions",
        "patterns",
        "repeated_patterns"
      ],
      "additionalProperties": false
    },
    "patterns": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "subgraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        }
      },
      "required": [
        "nodes",
        "edges",
        "paths",
        "subgraphs"
      ],
      "additionalProperties": false
    },
    "interpretation_status": {
      "const": "observed_graph_statistics_only"
    },
    "actual_student_behavior": {
      "const": "not_observed"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "architecture_version",
    "implementation_milestone",
    "engine_version",
    "scope",
    "parameters",
    "coverage",
    "exam_denominators",
    "input_graphs",
    "counts",
    "patterns",
    "interpretation_status",
    "actual_student_behavior",
    "notes",
    "dataset_hash",
    "content_hash",
    "revision",
    "previous_hash",
    "updated_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backspace milestone v0.3 question-local pattern statistics",
  "$defs": {
    "signature": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "concept"
            },
            "concept_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "concept_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reasoning"
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "node_descriptor": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/signature"
        }
      },
      "required": [
        "node"
      ],
      "additionalProperties": false
    },
    "edge_descriptor": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/signature"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "$ref": "#/$defs/signature"
        }
      },
      "required": [
        "from",
        "relation",
        "to"
      ],
      "additionalProperties": false
    },
    "path_descriptor": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signature"
          },
          "minItems": 3,
          "maxItems": 4
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 3
        }
      },
      "required": [
        "nodes",
        "relations"
      ],
      "additionalProperties": false
    },
    "subgraph_descriptor": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signature"
          },
          "minItems": 3,
          "maxItems": 4
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 0
              },
              "relation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to",
              "relation"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "properties": {
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "edge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      },
      "required": [
        "node_ids",
        "edge_ids",
        "evidence"
      ],
      "additionalProperties": false
    },
    "pattern_evidence": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "exam_id": {
          "type": "string",
          "minLength": 1
        },
        "question_graph_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          },
          "minItems": 1
        }
      },
      "required": [
        "question_id",
        "exam_id",
        "question_graph_hash",
        "occurrences"
      ],
      "additionalProperties": false
    },
    "exam_support": {
      "type": "object",
      "properties": {
        "exam_id": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "support_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "exam_id",
        "support",
        "denominator",
        "support_ratio"
      ],
      "additionalProperties": false
    },
    "pattern": {
      "type": "object",
      "properties": {
        "pattern_id": {
          "type": "string",
          "pattern": "^pat_[a-f0-9]{24}$"
        },
        "mode": {
          "enum": [
            "reasoning_structure",
            "concept_reasoning"
          ]
        },
        "kind": {
          "enum": [
            "nodes",
            "edges",
            "paths",
            "subgraphs"
          ]
        },
        "descriptor": {
          "oneOf": [
            {
              "$ref": "#/$defs/node_descriptor"
            },
            {
              "$ref": "#/$defs/edge_descriptor"
            },
            {
              "$ref": "#/$defs/path_descriptor"
            },
            {
              "$ref": "#/$defs/subgraph_descriptor"
            }
          ]
        },
        "support": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "support_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "occurrence_count": {
          "type": "integer",
          "minimum": 1
        },
        "is_repeated": {
          "type": "boolean"
        },
        "meets_min_support": {
          "type": "boolean"
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "by_exam": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exam_support"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern_evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "pattern_id",
        "mode",
        "kind",
        "descriptor",
        "support",
        "denominator",
        "support_ratio",
        "occurrence_count",
        "is_repeated",
        "meets_min_support",
        "question_ids",
        "by_exam",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "nodes"
              }
            }
          },
          "then": {
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/node_descriptor"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "edges"
              }
            }
          },
          "then": {
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/edge_descriptor"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "paths"
              }
            }
          },
          "then": {
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/path_descriptor"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "subgraphs"
              }
            }
          },
          "then": {
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/subgraph_descriptor"
              }
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "exam",
            "learning_material",
            "answer_key"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_evidence": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        },
        "offset_policy": {
          "const": "first_exact_match"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transcription": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "source",
        "source_title",
        "source_kind",
        "source_sha256",
        "page",
        "locator",
        "question_id",
        "raw_evidence",
        "char_start",
        "char_end",
        "offset_policy",
        "confidence"
      ],
      "additionalProperties": false
    }
  }
}
