{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "evidence_id", "evidence_hash", "hypothesis_id", "relation", "strength", "scope", "jev_probability", "jev_confidence", "question_version", "question_versions", "jev_decision_id", "created_at", "status", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_id": {"type": "string"},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hypothesis_id": {"type": "string"},
    "relation": {"enum": ["reinforces", "weakens", "contradicts", "narrows_scope", "broadens_scope", "unrelated", "insufficient"]},
    "raw_relation": {"enum": ["reinforces", "weakens", "contradicts", "narrows_scope", "broadens_scope", "unrelated", "insufficient", null]},
    "strength": {"type": ["number", "null"], "minimum": 0, "maximum": 3},
    "scope": {"enum": ["single_question", "question_type", "topic", "unit", "cross_unit", "global", "insufficient", null]},
    "jev_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "jev_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "question_version": {"type": "string"},
    "question_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "jev_decision_id": {"type": "string"},
    "created_at": {"type": "string"},
    "status": {"enum": ["applied", "pending_review"]},
    "coverage": {"type": "object"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
