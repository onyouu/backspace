{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "architecture_version": {
      "const": "teacher-intelligence-0.1"
    },
    "implementation_milestone": {
      "const": "0.4"
    },
    "generator_version": {
      "const": "teacher-hypothesis-1"
    },
    "scope": {
      "type": "object",
      "properties": {
        "teacher_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "teacher_identity_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "teacher_id",
        "subject",
        "label",
        "teacher_identity_verified"
      ],
      "additionalProperties": false
    },
    "input_context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "dataset_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "patterns_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "material_graph_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "dataset_hash",
        "patterns_hash",
        "material_graph_hash"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "total_repeated_eligible_patterns": {
          "type": "integer",
          "minimum": 0
        },
        "selected_pattern_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skipped_pattern_ids_for_question_budget": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "context_question_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_included_questions": {
          "type": "integer",
          "minimum": 0
        },
        "material_items_selected": {
          "type": "integer",
          "minimum": 0
        },
        "material_items_available": {
          "type": "integer",
          "minimum": 0
        },
        "context_chars": {
          "type": "integer",
          "minimum": 0
        },
        "counter_search_scope": {
          "const": "provided_context_only"
        }
      },
      "required": [
        "total_repeated_eligible_patterns",
        "selected_pattern_ids",
        "skipped_pattern_ids_for_question_budget",
        "context_question_ids",
        "context_question_count",
        "total_included_questions",
        "material_items_selected",
        "material_items_available",
        "context_chars",
        "counter_search_scope"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "properties": {
        "max_patterns": {
          "type": "integer",
          "minimum": 1
        },
        "max_questions": {
          "type": "integer",
          "minimum": 2
        },
        "max_material_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_context_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_hypotheses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "max_patterns",
        "max_questions",
        "max_material_items",
        "max_context_chars",
        "max_hypotheses"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "generated",
            "abstained",
            "no_eligible_repeated_patterns",
            "incremental"
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "fallback": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoning_effort": {
                  "anyOf": [
                    {
                      "enum": [
                        "none",
                        "low",
                        "high"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_tokens": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "model",
                "fallback",
                "reasoning_effort",
                "max_tokens"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "model",
        "configuration"
      ],
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      },
      "maxItems": 256
    },
    "evidence_registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "abstention_reason": {
      "type": "string"
    },
    "actual_student_behavior": {
      "const": "not_observed"
    },
    "scoring_status": {
      "const": "pending_jev"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "understanding_memory": {
      "type": "object",
      "required": [
        "version",
        "notes",
        "selected",
        "eligible",
        "context_hash",
        "limitations"
      ]
    },
    "semantic_control_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "architecture_version",
    "implementation_milestone",
    "generator_version",
    "scope",
    "input_context_hash",
    "inputs",
    "selection",
    "parameters",
    "generation",
    "hypotheses",
    "evidence_registry",
    "abstention_reason",
    "actual_student_behavior",
    "scoring_status",
    "content_hash",
    "revision",
    "previous_hash",
    "updated_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backspace milestone v0.4 provisional teacher hypotheses",
  "$defs": {
    "hypothesis": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "pattern_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "interpretation_status": {
                "const": "llm_proposed_unscored"
              }
            },
            "required": [
              "evidence_id",
              "reason",
              "interpretation_status"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "counter_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "interpretation_status": {
                "const": "llm_proposed_unscored"
              }
            },
            "required": [
              "evidence_id",
              "reason",
              "interpretation_status"
            ],
            "additionalProperties": false
          }
        },
        "counter_evidence_status": {
          "enum": [
            "identified",
            "no_counter_identified_in_provided_context"
          ]
        },
        "applicable_context": {
          "type": "object",
          "properties": {
            "exam_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "concept_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "reasoning_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "exam_ids",
            "concept_ids",
            "reasoning_codes",
            "conditions"
          ],
          "additionalProperties": false
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "next_validation_data": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "id": {
          "type": "string",
          "pattern": "^hyp_[a-f0-9]{24}$"
        },
        "status": {
          "const": "provisional"
        },
        "review_status": {
          "const": "unreviewed"
        },
        "scoring_status": {
          "const": "pending_jev"
        },
        "confidence": {
          "type": "null"
        },
        "supporting_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "structural_statistics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern_id": {
                "type": "string",
                "minLength": 1
              },
              "support": {
                "type": "integer",
                "minimum": 1
              },
              "denominator": {
                "type": "integer",
                "minimum": 1
              },
              "support_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "by_exam": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "exam_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "support": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "denominator": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "support_ratio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "exam_id",
                    "support",
                    "denominator",
                    "support_ratio"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "pattern_id",
              "support",
              "denominator",
              "support_ratio",
              "by_exam"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "statistics_meaning": {
          "const": "pattern_support_not_hypothesis_probability"
        },
        "jev_validation": {
          "type": "object",
          "properties": {
            "decision_id": {
              "type": "string"
            },
            "question_version": {
              "type": "string"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "decision_status": {
              "enum": [
                "success",
                "fallback"
              ]
            },
            "summary_status": {
              "enum": [
                "supports",
                "contradicts",
                "insufficient",
                "irrelevant",
                "needs_review"
              ]
            },
            "scope": {
              "type": [
                "string",
                "null"
              ]
            },
            "needs_reanalysis": {
              "type": "boolean"
            },
            "strength_score": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "strength_confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "evidence_relation": {
              "enum": [
                "supports",
                "contradicts",
                "insufficient",
                "irrelevant",
                null
              ]
            }
          },
          "required": [
            "decision_id",
            "question_version",
            "model",
            "decision_status",
            "summary_status",
            "scope",
            "needs_reanalysis",
            "strength_score",
            "strength_confidence"
          ],
          "additionalProperties": false
        },
        "lifecycle_status": {
          "enum": [
            "candidate",
            "active",
            "weak",
            "contested",
            "retired",
            "rejected"
          ]
        },
        "incremental_state": {
          "type": "object"
        }
      },
      "required": [
        "statement",
        "pattern_ids",
        "supporting_evidence",
        "counter_evidence",
        "counter_evidence_status",
        "applicable_context",
        "alternative_explanations",
        "next_validation_data",
        "limitations",
        "id",
        "status",
        "review_status",
        "scoring_status",
        "confidence",
        "supporting_question_ids",
        "structural_statistics",
        "statistics_meaning"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev_[a-f0-9]{24}$"
        },
        "kind": {
          "enum": [
            "question",
            "material_concept",
            "material_relation"
          ]
        },
        "origin_id": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "origin_id",
        "citations",
        "details"
      ],
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "raw_evidence": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "transcription": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "source",
        "source_sha256",
        "locator",
        "raw_evidence",
        "char_start",
        "char_end",
        "question_id",
        "confidence"
      ],
      "additionalProperties": true
    }
  }
}
