{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "architecture_version": {
      "const": "teacher-intelligence-0.1"
    },
    "implementation_milestone": {
      "const": "0.2"
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "exam_id": {
      "type": "string",
      "minLength": 1
    },
    "question_number": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "teacher_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "teacher_identity_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "teacher_id",
        "subject",
        "label",
        "teacher_identity_verified"
      ],
      "additionalProperties": false
    },
    "analysis_version": {
      "const": "grounded-2.3"
    },
    "analysis_status": {
      "enum": [
        "ai_reviewed",
        "needs_reference_review"
      ]
    },
    "actual_student_behavior": {
      "const": "not_observed"
    },
    "confidence_meaning": {
      "const": "extraction_self_report_not_teacher_importance"
    },
    "input_context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "answer_key_context": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "provided",
            "not_provided"
          ]
        },
        "exam_locator": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "block_id": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "block_id",
              "source_id",
              "source_sha256",
              "locator",
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "exam_locator",
        "blocks"
      ],
      "additionalProperties": false
    },
    "answer_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "learning_material",
              "exam",
              "answer_key"
            ]
          },
          "format": {
            "enum": [
              "pdf",
              "jpg",
              "jpeg",
              "png",
              "txt",
              "pptx",
              "synthetic"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "path",
          "sha256",
          "kind",
          "format"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "concept",
              "task",
              "reasoning",
              "evidence_of_understanding",
              "assessment_intent"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/citation"
            }
          },
          "observation_status": {
            "enum": [
              "required",
              "required_candidate",
              "hypothesis"
            ]
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "confidence",
          "evidence",
          "observation_status",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "applied_in",
              "requires_reasoning",
              "demonstrated_by",
              "supports_intent_candidate",
              "precedes",
              "supports",
              "requires",
              "contrasts"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/citation"
            }
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "relation",
          "explanation",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/citation"
            }
          },
          "review_status": {
            "enum": [
              "supported",
              "domain_knowledge_needs_review"
            ]
          },
          "review_reason": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "model",
              "step_output"
            ]
          },
          "step_id": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "statement",
          "conditions",
          "evidence",
          "review_status",
          "review_reason",
          "origin",
          "step_id",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "review_history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "candidate_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "review": {
            "type": "object",
            "properties": {
              "claim_verdicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {
                      "enum": [
                        "supported",
                        "contradicted",
                        "insufficient_evidence",
                        "domain_knowledge_needs_review"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "index",
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "step_verdicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {
                      "enum": [
                        "supported",
                        "contradicted",
                        "insufficient_evidence",
                        "domain_knowledge_needs_review"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "index",
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "link_verdicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {
                      "enum": [
                        "supported",
                        "contradicted",
                        "insufficient_evidence",
                        "domain_knowledge_needs_review"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "index",
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "missing_requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "task_verdicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {
                      "enum": [
                        "supported",
                        "contradicted",
                        "insufficient_evidence",
                        "domain_knowledge_needs_review"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "index",
                    "status",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "claim_verdicts",
              "step_verdicts",
              "link_verdicts",
              "missing_requirements",
              "issues"
            ],
            "additionalProperties": false
          },
          "review_model": {
            "type": "string",
            "minLength": 1
          },
          "grounding_model": {
            "type": "string",
            "minLength": 1
          },
          "grounding_verdicts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "supported",
                    "contradicted",
                    "insufficient_evidence",
                    "domain_knowledge_needs_review"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "index",
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "attempt",
          "candidate_hash",
          "review",
          "review_model"
        ],
        "additionalProperties": false
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "schema_version",
    "architecture_version",
    "implementation_milestone",
    "question_id",
    "exam_id",
    "question_number",
    "scope",
    "analysis_version",
    "analysis_status",
    "actual_student_behavior",
    "confidence_meaning",
    "input_context_hash",
    "answer_key_context",
    "answer_requirements",
    "sources",
    "nodes",
    "edges",
    "claims",
    "review_history",
    "content_hash",
    "revision",
    "previous_hash",
    "updated_at",
    "confidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backspace milestone v0.2 isolated Question Graph",
  "$defs": {
    "citation": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "exam",
            "learning_material",
            "answer_key"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_evidence": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        },
        "offset_policy": {
          "const": "first_exact_match"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transcription": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "source",
        "source_title",
        "source_kind",
        "source_sha256",
        "page",
        "locator",
        "question_id",
        "raw_evidence",
        "char_start",
        "char_end",
        "offset_policy",
        "confidence"
      ],
      "additionalProperties": false
    }
  }
}
