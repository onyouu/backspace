BACKSPACE_LLM_PROVIDER=gemini
# Only use free-tier Gemini models; Jev remains available separately.
BACKSPACE_FREE_LLM_ONLY=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_TOKENS=8192
GEMINI_THINKING_LEVEL=low
# Optional task-specific overrides: GEMINI_VISION_MODEL, GEMINI_MATERIAL_MODEL,
# GEMINI_EXAM_MODEL, GEMINI_UNDERSTANDING_MODEL, GEMINI_REVIEW_MODEL,
# GEMINI_HYPOTHESIS_MODEL, GEMINI_PLAN_MODEL
# Legacy provider remains available with BACKSPACE_LLM_PROVIDER=nvidia.
NVIDIA_API_KEY=
NVIDIA_SUPER_API_KEY=
NVIDIA_LIGHTNING_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MATERIAL_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EXAM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_REVIEW_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_VISION_MODEL=meta/muse-glimmer-30b
NVIDIA_MEMORY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
BACKSPACE_MEMORY_ENABLED=1
# Local scheduling ceilings, not the provider's verified account limits.
BACKSPACE_API_RPM=8
BACKSPACE_API_TPM=24000
BACKSPACE_API_RPD=200
BACKSPACE_OCR_THREADS=1
BACKSPACE_MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BACKSPACE_MEMORY_MAX_DISTANCE=0.8
NVIDIA_REASONING_EFFORT=low
NVIDIA_REVIEW_REASONING_EFFORT=none
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_MAX_TOKENS=16000
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# v0.5 implementation; live API verification deferred until v0.7.

# v0.4 hypothesis generation (API runs deferred until v0.7)
NVIDIA_HYPOTHESIS_MODEL=nvidia/nemotron-3-super-120b-a12b

JEV_TIMEOUT_SECONDS=45
BACKSPACE_JEV_CONTROL_ENABLED=1
JEV_SLOW_REASONING_THRESHOLD=0.8
JEV_LOW_CONFIDENCE_THRESHOLD=0.65
JEV_GRAPH_PROJECTION_THRESHOLD=0.8
# Remaining thresholds/state bounds: backspace_mvp/jev_thresholds.json

# v0.7 natural-language study tasks
NVIDIA_PLAN_MODEL=nvidia/nemotron-3-super-120b-a12b
